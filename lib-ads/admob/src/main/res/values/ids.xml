<?xml version="1.0" encoding="utf-8"?>
<!--
  View id chuẩn cho native ad layout. App có thể tự tạo layout XML riêng và tham chiếu
  các id này (@id/ad_headline ...) để truyền vào NativeAd(layoutResId = R.layout.my_native).
-->
<resources>
    <item name="ad_headline" type="id" />
    <item name="ad_body" type="id" />
    <item name="ad_call_to_action" type="id" />
    <item name="ad_app_icon" type="id" />
    <item name="ad_media" type="id" />
</resources>
