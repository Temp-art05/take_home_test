<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+. Mặc định backup TẤT CẢ, nên phải loại trừ tường minh những thứ không nên
  theo user sang máy mới: cache remote config, và (khi project thêm) token/secret.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
