# Built application files
*.apk
*.aar
# Lib ads vendor dạng maven local (settings.gradle.kts) — phải vào git.
!third_party/maven/**/*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
/build
**/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/
/captures

# IntelliJ
*.iml
.idea/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Keystore — không bao giờ commit
*.jks
*.keystore

# External native build folder
.externalNativeBuild/
.cxx/

# google-services.json được commit: đề bài yêu cầu, file này không phải secret

# Secrets / Environment files
*.env
.env.*
secrets.properties

# Kotlin
*.kotlin_metadata
.kotlin/

# NDK
obj/

# Crashlytics
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor backup files
*~
*.swp
*.swo

# Claude Code
.claude/logs/

# Local plans (theo rule: plan không commit)
docs/plans/

# Claude Code workspace
.claude/
.station/
